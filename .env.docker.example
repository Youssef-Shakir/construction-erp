# ---------------------------------------------------------------------------
# Docker environment. Copy to .env next to docker-compose.yml and change every
# "change-me". Generate secrets with:  openssl rand -base64 36
# ---------------------------------------------------------------------------

# Django
DEBUG=False
SECRET_KEY=change-me-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
LOG_LEVEL=INFO
# Public domain for HTTPS (docker-compose.prod.yml / Caddy)
DOMAIN=erp.example.com

# First admin account, created on first start
DJANGO_SUPERUSER_EMAIL=owner@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_FIRST_NAME=المدير

# PostgreSQL
DB_NAME=construction_erp
DB_USER=erp
DB_PASSWORD=change-me

# MinIO (S3) - root account is only used by minio-init to create the bucket
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Restricted account the app uses (read/write on this bucket only)
AWS_STORAGE_BUCKET_NAME=erp-attachments
AWS_ACCESS_KEY_ID=erp-app
AWS_SECRET_ACCESS_KEY=change-me-at-least-8-chars

# Attachments
ATTACHMENT_MAX_UPLOAD_MB=25
# Scanned PDF compression: ebook (150 dpi) | printer (300 dpi) | screen | off
ATTACHMENT_PDF_COMPRESSION=ebook

# Which compose files to use (Docker reads this from .env)
#   own server with Caddy HTTPS : docker-compose.yml:docker-compose.prod.yml
#   behind a Cloudflare Tunnel  : docker-compose.yml:docker-compose.tunnel.yml
COMPOSE_FILE=docker-compose.yml
# Cloudflare Tunnel only: network of the cloudflared container + a free fixed IP in it
TUNNEL_NETWORK=ilumina
TUNNEL_IP=172.20.0.20
# Smaller servers: fewer gunicorn processes (each ~120 MB)
GUNICORN_WORKERS=2

# Ports on the host (bound to 127.0.0.1)
WEB_PORT=8080
MINIO_CONSOLE_PORT=9001
# Host folder the office scanner saves into (scanner profile)
SCAN_HOST_DIR=./scans
