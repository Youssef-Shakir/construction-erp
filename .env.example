# ---------------------------------------------------------------------------
# Construction ERP - environment. Copy to .env and adjust.
# Development:  DEBUG=True, then  DJANGO_SETTINGS_MODULE=config.dev_settings
# Production:   DEBUG=False (default) and every value below set for real.
# ---------------------------------------------------------------------------

# Django
DEBUG=False
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
ALLOWED_HOSTS=erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
LOG_LEVEL=INFO

# HTTPS (behind nginx). Enable HSTS only once HTTPS works everywhere.
SECURE_SSL_REDIRECT=True
SECURE_COOKIES=True
SECURE_HSTS_SECONDS=0

# Database (PostgreSQL 16)
DB_NAME=construction_erp
DB_USER=construction_erp
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Files
MEDIA_ROOT=/srv/construction-erp/media
ATTACHMENT_MAX_UPLOAD_MB=25
# nginx internal location that maps to MEDIA_ROOT (see docs/DEPLOYMENT.md)
ATTACHMENT_X_ACCEL_PREFIX=
# Folder the office scanner saves to ("scan to folder"), imported by `manage.py import_scans`
SCAN_INBOX_DIR=/srv/construction-erp/scans
